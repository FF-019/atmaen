# copy to .env and change values

# sqlite for local dev, mysql for staging/prod
DATABASE_URL=sqlite:///./atmaen.db
# DATABASE_URL=mysql+pymysql://atmaen:atmaen@localhost:3306/atmaen

SECRET_KEY=change-me-please
ACCESS_TOKEN_MINUTES=720

# comma separated
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

UPLOAD_DIR=uploads
IMAGE_MODEL_PATH=models_store/chemical_classifier.keras

# first admin account (created by scripts/seed.py)
ADMIN_EMAIL=admin@atmaen.sa
ADMIN_PASSWORD=Admin@12345
